@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontSize 14
skinparam nodesep 25
skinparam ranksep 45
skinparam usecase {
  BackgroundColor #FEFEFE
  BorderColor #333333
  ArrowColor #333333
  FontSize 13
}
skinparam actor {
  BorderColor #333333
}
skinparam package {
  BorderColor #888888
  FontStyle bold
  BackgroundColor #FBFBFB
}

actor Administrador as Admin

package "Módulo Administrativo (Web)" as PkgAdmin {
  usecase "Autenticar-se no Painel\nAdministrativo" as UCLoginAdmin
  usecase "Gerenciar Departamentos" as UC01
  usecase "Gerenciar Atendentes" as UC02
  usecase "Visualizar Dashboard de\nAtendimentos" as UC03
  usecase "Filtrar por Período" as UC03b
  usecase "Monitorar Conversas dos\nAtendentes" as UC04
  usecase "Configurar Chatbot" as UC05
}

Admin -- UCLoginAdmin
Admin -- UC01
Admin -- UC02
Admin -- UC03
Admin -- UC04
Admin -- UC05
UC01 ..> UCLoginAdmin : <<include>>
UC02 ..> UCLoginAdmin : <<include>>
UC03 ..> UCLoginAdmin : <<include>>
UC04 ..> UCLoginAdmin : <<include>>
UC05 ..> UCLoginAdmin : <<include>>
UC03b ..> UC03 : <<extend>>

actor Atendente

package "Módulo do Atendente (Mobile)" as PkgAtd {
  usecase "Autenticar-se no Aplicativo" as UC06
  usecase "Alterar Status de\nDisponibilidade" as UC07
  usecase "Visualizar Atendimentos\nDirecionados" as UC08
  usecase "Responder Cliente" as UC09
  usecase "Encerrar Atendimento" as UC10
  usecase "Marcar Atendimento como\nAguardando Retorno" as UC11
}

Atendente -- UC06
Atendente -- UC07
Atendente -- UC08
Atendente -- UC09
Atendente -- UC10
Atendente -- UC11
UC07 ..> UC06 : <<include>>
UC08 ..> UC06 : <<include>>
UC09 ..> UC06 : <<include>>
UC10 ..> UC06 : <<include>>
UC11 ..> UC06 : <<include>>

actor Cliente
actor "API Meta\n(WhatsApp)" as Meta

package "Chatbot" as PkgBot {
  usecase "Solicitar Atendimento via\nWhatsApp" as UC12
  usecase "Registrar Histórico de\nConversa" as UC13
}

Cliente -- UC12
UC12 ..> UC13 : <<include>>
UC12 -- Meta
UC09 ..> UC13 : <<include>>
UC09 -- Meta

@enduml
